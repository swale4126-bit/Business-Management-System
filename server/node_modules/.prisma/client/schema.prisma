// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
  RETURN
}

enum NotificationType {
  LOW_STOCK
  NEW_EMPLOYEE
  NEW_CUSTOMER
  NEW_SALE
  SYSTEM
}

// ─────────────────────────────────────────────
// User (Authentication)
// ─────────────────────────────────────────────

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  password             String
  firstName            String
  lastName             String
  phone                String?
  profilePhoto         String?
  role                 Role      @default(STAFF)
  isActive             Boolean   @default(true)
  refreshToken         String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  mustChangePassword   Boolean   @default(false)
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  employee      Employee?
  createdSales  Sale[]         @relation("CreatedBySales")
  notifications Notification[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Employee
// ─────────────────────────────────────────────

model Employee {
  id         String         @id @default(cuid())
  userId     String         @unique
  employeeId String         @unique // e.g. EMP001
  department String?
  position   String?
  salary     Decimal?       @db.Decimal(12, 2)
  hireDate   DateTime?
  address    String?
  status     EmployeeStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employees")
}

// ─────────────────────────────────────────────
// Customer
// ─────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  city      String?
  country   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sales Sale[]

  @@map("customers")
}

// ─────────────────────────────────────────────
// Supplier
// ─────────────────────────────────────────────

model Supplier {
  id            String   @id @default(cuid())
  name          String
  email         String?  @unique
  phone         String?
  address       String?
  city          String?
  country       String?
  contactPerson String?
  website       String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  products       Product[]
  stockMovements StockMovement[]

  @@map("suppliers")
}

// ─────────────────────────────────────────────
// Category
// ─────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  products Product[]

  @@map("categories")
}

// ─────────────────────────────────────────────
// Product
// ─────────────────────────────────────────────

model Product {
  id           String        @id @default(cuid())
  name         String
  sku          String        @unique
  barcode      String?       @unique
  description  String?
  buyingPrice  Decimal       @db.Decimal(12, 2)
  sellingPrice Decimal       @db.Decimal(12, 2)
  quantity     Int           @default(0)
  minStock     Int           @default(5)
  image        String?
  status       ProductStatus @default(ACTIVE)
  categoryId   String
  supplierId   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  category       Category        @relation(fields: [categoryId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@map("products")
}

// ─────────────────────────────────────────────
// Sale
// ─────────────────────────────────────────────

model Sale {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  customerId     String?
  createdById    String
  subtotal       Decimal       @db.Decimal(12, 2)
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  status         SaleStatus    @default(COMPLETED)
  paymentMethod  PaymentMethod @default(CASH)
  paymentStatus  PaymentStatus @default(PAID)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  customer  Customer?  @relation(fields: [customerId], references: [id])
  createdBy User       @relation("CreatedBySales", fields: [createdById], references: [id])
  saleItems SaleItem[]
  payments  Payment[]

  @@map("sales")
}

// ─────────────────────────────────────────────
// SaleItem
// ─────────────────────────────────────────────

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String
  productName String // snapshot at time of sale
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  // Relations
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

// ─────────────────────────────────────────────
// Payment
// ─────────────────────────────────────────────

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod @default(CASH)
  reference String?
  notes     String?
  createdAt DateTime      @default(now())

  // Relations
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ─────────────────────────────────────────────
// StockMovement (Inventory History)
// ─────────────────────────────────────────────

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  supplierId  String?
  type        StockMovementType
  quantity    Int
  previousQty Int
  newQty      Int
  reason      String?
  reference   String? // Sale ID or PO number
  createdById String?
  createdAt   DateTime          @default(now())

  // Relations
  product  Product   @relation(fields: [productId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@map("stock_movements")
}

// ─────────────────────────────────────────────
// Notification
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
